# Backend settings for a local FastAPI run. Copy to .env and export before starting uvicorn.
FLOWSYNC_EXPERIMENT_DB=.flowsync/experiments.sqlite3
# Optional. Set DATABASE_URL to use PostgreSQL instead of local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FLOWSYNC_LOG_LEVEL=INFO
FLOWSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set this only when SUMO is installed outside the standard location.
# SUMO_HOME=/path/to/sumo
